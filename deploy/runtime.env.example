# Bondok runtime configuration (placeholders only; the real file is /opt/waset-bondok/runtime.env, mode 0600).
PIPELINE_DB=/var/lib/bondok/pipeline/state.sqlite
MONDAY_API_TOKEN=<set-on-server>
DROPBOX_APP_KEY=<set-on-server>
DROPBOX_APP_SECRET=<set-on-server>
DROPBOX_REFRESH_TOKEN=<set-on-server>
INSTAGRAM_ACCOUNT_ID=<ig-user-id>
INSTAGRAM_TOKEN=<set-on-server>
OPENROUTER_API_KEY=<set-on-server>
# instagram_login (60-day token, refreshed by the runtime) or facebook_page (long-lived page token, no refresh)
INSTAGRAM_TOKEN_KIND=<instagram_login|facebook_page>
