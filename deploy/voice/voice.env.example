# /etc/bondok-voice/voice.env on the Bondok host: owner bondok, mode 0400, directory 0750 root:bondok.
# Only what the voice service needs. No Slack tokens. Values are never committed.
VOICE_ENABLED=1
SLACK_OWNER_ID=<the Bondok owner's Slack id: the owner line acts as this identity>
PIPELINE_DB=/var/lib/bondok/pipeline/state.sqlite
BONDOK_STATE_DIR=/var/lib/bondok
MONDAY_API_TOKEN=<copied from /opt/waset-bondok/.env>
OPENROUTER_API_KEY=<copied from /opt/waset-bondok/.env>
OPENROUTER_MODEL=<copied from /opt/waset-bondok/.env, if set>
VOICE_ACCESS_FILE=/etc/bondok-voice/voice-access.json
VOICE_LLM_BIND=127.0.0.1
VOICE_LLM_PORT=8790
VOICE_LLM_KEY=<random, 48+ chars; stored in ElevenLabs as the custom-LLM secret>
VOICE_SESSION_BIND=<this host's Tailscale address>
VOICE_SESSION_PORT=8791
VOICE_SESSION_SECRET=<random, 48+ chars; shared only with the PBX bridge env>
