# /etc/bondok-voice/bridge.env on the PBX host: root, mode 0400 (read by Docker as env_file; never mounted).
ELEVENLABS_API_KEY=<copied from Sara's .env: same account, quota shared>
BONDOK_ELEVENLABS_AGENT_ID=<the Bondok agent's id (el_agent.py output)>
BONDOK_BRIDGE_HOST=127.0.0.1
BONDOK_BRIDGE_PORT=9020
BONDOK_SESSION_URL=http://<Bondok host Tailscale address>:8791
VOICE_SESSION_SECRET=<same value as in the Bondok host's voice.env>
BONDOK_VOICE_ENABLED=1
# Approved budget for Bondok's own agent time (prior test usage included), and the account credits kept for Sara.
BONDOK_BUDGET_SECONDS=600
BONDOK_PRIOR_SECONDS=2
BONDOK_PRIOR_NOTE=fixture TTS clips, 11 credits (2026-10-16)
BONDOK_SARA_RESERVE_CREDITS=15000
BONDOK_LEDGER=/var/lib/bondok-voice/ledger.json
LOG_LEVEL=INFO
LOG_FORMAT=json
