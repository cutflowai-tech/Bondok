{
 "_comment": "Template for deploy.py --config. Copy to a private, root-only path on the server and fill in. Never commit the filled copy. Since 2026-10-15 Bondok's store is a Bondok-owned host folder: no n8n container, volume or workflow is involved (the old 'n8n' section is gone).",
 "state_dir": "/root/bondok-deploy/state",
 "backup_root": "/root/bondok-deploy/backups",
 "lock_file": "/root/bondok-deploy/deploy.lock",
 "host_python": "/usr/bin/python3",
 "helper": {
  "data_dir": "/var/lib/bondok/pipeline",
  "runner": [
   "runuser",
   "-u",
   "bondok",
   "--",
   "/usr/bin/python3"
  ],
  "runner_data_dir": "/var/lib/bondok/pipeline",
  "runner_env": {
   "WASET_SOCIAL_DATA_DIR": "/var/lib/bondok/pipeline"
  },
  "owner": [
   "<bondok uid>",
   "<bondok gid>"
  ]
 },
 "bondok": {
  "code_dir": "<Bondok code directory>",
  "python": "<Bondok venv python>",
  "db": "<Bondok sqlite file>",
  "unit_files": [
   "/etc/systemd/system/bondok.service",
   "/etc/systemd/system/waset-runtime.service"
  ],
  "stop": [
   [
    "systemctl",
    "stop",
    "waset-runtime"
   ],
   [
    "systemctl",
    "stop",
    "bondok"
   ]
  ],
  "start": [
   [
    "systemctl",
    "start",
    "bondok"
   ],
   [
    "systemctl",
    "start",
    "waset-runtime"
   ]
  ],
  "health": {
   "command": [
    "systemctl",
    "is-active",
    "bondok"
   ],
   "expect_stdout": "active"
  }
 },
 "drain": {
  "timeout_seconds": 900,
  "poll_seconds": 5
 },
 "contain_commands": [],
 "sqlite_runner": [
  "runuser",
  "-u",
  "bondok",
  "--"
 ]
}
