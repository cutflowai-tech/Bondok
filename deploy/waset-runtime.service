# Bondok runtime: the scheduled work that n8n WF1/WF2/WF3 ran (agent migration P4). Template; paths are examples.
# Starts idle: it executes nothing until the owner switches scheduled work to it (Ops command set_runtime_owner).
[Unit]
Description=Waset Bondok runtime (preparation, publishing, supervision)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bondok
Environment=WASET_RUNTIME_ENV=/opt/waset-bondok/runtime.env
ExecStart=/usr/bin/python3 -m waset_runtime.service
WorkingDirectory=/opt/waset-bondok
Restart=always
RestartSec=10
# The store and the prepared media live in the shared data directory (same as the helper).
ReadWritePaths=/var/lib/bondok
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
