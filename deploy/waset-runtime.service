# Bondok runtime: the scheduled work that n8n WF1/WF2/WF3 ran (agent migration P4).
# Starts idle: it executes nothing until scheduled work is switched to it (ops_meta.runtime_owner = bondok).
[Unit]
Description=Waset Bondok runtime (import, preparation, publishing, reconciliation, supervision)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=bondok
Group=bondok
WorkingDirectory=/opt/waset-bondok
Environment=WASET_RUNTIME_ENV=/opt/waset-bondok/runtime.env
Environment=WASET_HELPER=/var/lib/bondok/pipeline/helper.py
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m waset_runtime.service
Restart=always
RestartSec=10
TimeoutStopSec=960
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bondok
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=3G
TasksMax=256

[Install]
WantedBy=multi-user.target
